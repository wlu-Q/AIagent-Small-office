{
  "name": "small-office-client",
  "private": true,
  "description": "小小办公室本地桌面客户端",
  "version": "1.0.0",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:employee-interaction": "node --test tests/employee-interaction.test.cjs",
    "test:employee-pickup": "node --test tests/employee-pickup.test.cjs",
    "test:workstation": "node --test tests/workstation.test.cjs",
    "assets:workstation": "node scripts/assemble-workstation-assets.cjs",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n.cjs"
  },
  "dependencies": {
    "@antv/g6": "5.1.1",
    "@emotion/react": "^11.9.0",
    "@emotion/styled": "^11.8.1",
    "@mui/icons-material": "^5.0.1",
    "@mui/material": "^5.6.4",
    "docx-preview": "0.4.1",
    "echarts": "6.1.0",
    "i18next": "25.8.13",
    "mermaid": "12.3.0",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "4.10.38",
    "phaser": "^3.55.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "16.5.8",
    "react-markdown": "^9.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "sass": "^1.42.1",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
